{
  "manifest_version": 3,
  "name": "Loot for Apple Pay",
  "version": "0.1.0",
  "description": "See which eligible card to choose for Apple Pay before checkout.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "Loot for Apple Pay",
    "default_popup": "popup.html"
  }
}
